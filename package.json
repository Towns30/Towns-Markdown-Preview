{
  "name": "towns-markdown-preview",
  "displayName": "Towns Markdown Preview",
  "description": "Clean and elegant Markdown preview themes optimized for Chinese and English writing.",
  "version": "0.3.1",
  "publisher": "towns",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "markdown",
    "markdown-preview",
    "preview",
    "theme",
    "chinese",
    "notion",
    "paper",
    "dark",
    "sage",
    "cobalt"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:townsMarkdown.selectTheme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Towns30/Towns-Markdown-Preview.git"
  },
  "bugs": {
    "url": "https://github.com/Towns30/Towns-Markdown-Preview/issues"
  },
  "homepage": "https://github.com/Towns30/Towns-Markdown-Preview#readme",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "townsMarkdown.selectTheme",
        "title": "Select Theme",
        "category": "Towns Markdown"
      }
    ],
    "configuration": {
      "title": "Towns Markdown Preview",
      "properties": {
        "townsMarkdown.theme": {
          "type": "string",
          "enum": [
            "notion",
            "paper",
            "dark",
            "sage",
            "cobalt"
          ],
          "enumDescriptions": [
            "Clean, modern layout for notes and outlines.",
            "Warm, book-like layout for long-form reading.",
            "Restrained dark layout for technical notes.",
            "Calm sage-green layout for reading and study notes.",
            "Cobalt-blue layout for long-form reading and technical notes."
          ],
          "default": "notion",
          "scope": "window",
          "description": "Theme used by the built-in Markdown preview."
        }
      }
    },
    "markdown.previewStyles": [
      "./styles/base.css",
      "./styles/notion.css",
      "./styles/paper.css",
      "./styles/dark.css",
      "./styles/sage.css",
      "./styles/cobalt.css"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit -p ./ && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js --watch",
    "test": "esbuild test/upgrade.test.ts --bundle --platform=node --format=cjs --outfile=test/upgrade.test.cjs && node test/upgrade.test.cjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "markdown-it-task-lists": "^2.1.1"
  }
}
